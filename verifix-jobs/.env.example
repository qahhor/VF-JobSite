# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verifix_jobs
POSTGRES_USER=verifix
POSTGRES_PASSWORD=verifix_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=verifix-jobs

# JWT
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# SMS - Eskiz.uz
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=your-eskiz-email
ESKIZ_PASSWORD=your-eskiz-password

# SMS - PlayMobile (fallback)
PLAYMOBILE_BASE_URL=https://send.playmobile.uz
PLAYMOBILE_LOGIN=your-playmobile-login
PLAYMOBILE_PASSWORD=your-playmobile-password

# MyID
MYID_CLIENT_ID=your-myid-client-id
MYID_CLIENT_SECRET=your-myid-client-secret
MYID_REDIRECT_URI=https://jobs.verifix.uz/api/v1/auth/myid/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=verifixjobs_bot

# Click.uz
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SERVICE_ID=your-click-service-id
CLICK_SECRET_KEY=your-click-secret-key

# Payme
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret-key

# Application
APP_BASE_URL=https://jobs.verifix.uz
APP_PORT=8080
