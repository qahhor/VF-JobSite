# Verifix Jobs environment example
# Copy this file to .env and replace every placeholder before production deploy.

# Runtime
SPRING_PROFILES_ACTIVE=prod
APP_NAME=verifix-jobs
APP_BASE_URL=https://job.verifix.uz
APP_PORT=8080

# Public web origins
CORS_ORIGINS=https://job.verifix.uz

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=verifix_jobs
POSTGRES_USER=verifix
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password

# JWT
JWT_SECRET=replace-with-64-char-jwt-secret
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTIC_PASSWORD=replace-with-strong-elastic-password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# MinIO
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=replace-with-strong-minio-access-key
MINIO_SECRET_KEY=replace-with-strong-minio-secret-key
MINIO_BUCKET=verifix-jobs
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
GRAFANA_ROOT_URL=http://localhost:3000

# Telegram bot
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=VerifixJobBot
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEB_APP_URL=https://job.verifix.uz

# Telegram channel posting
TELEGRAM_CHANNEL_ENABLED=false
TELEGRAM_CHANNEL_CHAT_ID=

# SMS gateways
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=replace-with-eskiz-email
ESKIZ_PASSWORD=replace-with-eskiz-password
PLAYMOBILE_BASE_URL=https://send.playmobile.uz
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=

# Payments
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# MyID
MYID_CLIENT_ID=
MYID_CLIENT_SECRET=
MYID_REDIRECT_URI=${APP_BASE_URL}/api/v1/auth/myid/callback

# Verifix HRM
VERIFIX_HRM_URL=https://hrm.verifix.uz/api
VERIFIX_HRM_API_KEY=
HRM_SYNC_ENABLED=false
HRM_VACANCY_SYNC_CRON=0 */30 * * * *

# HRM SSO
HRM_SSO_ENABLED=false
HRM_SSO_CLIENT_ID=
HRM_SSO_CLIENT_SECRET=
HRM_SSO_REDIRECT_URI=${APP_BASE_URL}/api/v1/hrm/sso/callback

# AI
AI_CHATBOT_ENABLED=false
AI_SCREENING_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024

# ML
ML_SERVICE_ENABLED=false
ML_SERVICE_URL=http://ml-service:8000
ML_GRPC_HOST=ml-service
ML_GRPC_PORT=50051

# ATS Telegram integration
ATS_TELEGRAM_ENABLED=false
ATS_TELEGRAM_WEBHOOK_URL=
ATS_TELEGRAM_HMAC_SECRET=
ATS_TELEGRAM_COMPANY_CODE=default

# Government integrations
GOV_SYNC_ENABLED=false
ARGOS_API_URL=https://api.argos.uz
ARGOS_API_KEY=
ENST_API_URL=https://api.enst.uz
ENST_API_KEY=
MEHNAT_API_URL=https://api.ish.mehnat.uz
MEHNAT_API_KEY=

# Feature toggles
KAFKA_ENABLED=true
ELASTICSEARCH_ENABLED=true
MINIO_ENABLED=true

# Moderation and limits
MODERATION_MINIMUM_WAGE_UZS=1155000
MODERATION_BANNED_WORDS=MLM,network marketing,depozit,vlozhenie,piramida,zalog
RATE_LIMIT_GENERAL_REQUESTS_PER_MINUTE=100
RATE_LIMIT_EMPLOYER_REQUESTS_PER_MINUTE=30
