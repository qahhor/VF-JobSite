# ============================================================================
# Verifix Jobs — Environment Configuration
# ============================================================================
# Copy to .env and replace all "replace-..." placeholders before deploying.
# See CONFIG.md for detailed description of each section.
#
# Target capacity: DAU ~10,000 (peak ~1,000 concurrent users)
# ============================================================================

# ── 1. APP (General) ────────────────────────────────────────────────────────

# Spring Boot profile: dev | staging | prod                        [required]
SPRING_PROFILES_ACTIVE=prod

# Application name used in logs, metrics, tracing                  [optional]
APP_NAME=verifix-jobs

# Public-facing URL (used for OAuth callbacks, emails, sitemap)    [required]
APP_BASE_URL=https://job.verifix.uz

# Backend server port (inside container)                           [optional]
APP_PORT=8080

# Comma-separated allowed frontend origins for CORS                [required]
CORS_ORIGINS=https://job.verifix.uz

# ── 2. SECURITY & SECRETS ──────────────────────────────────────────────────

# JWT signing secret — min 32 chars, ideally 64                    [required]
JWT_SECRET=replace-with-64-char-jwt-secret

# Access token lifetime in ms (default: 15 min)                   [optional]
JWT_EXPIRATION_MS=900000

# Refresh token lifetime in ms (default: 7 days)                  [optional]
JWT_REFRESH_EXPIRATION_MS=604800000

# ── 3. DATABASE (PostgreSQL + PostGIS) ──────────────────────────────────────

# Database connection                                              [required]
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=verifix_jobs
POSTGRES_USER=verifix
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# HikariCP connection pool — tuned for DAU 10K                    [optional]
# Rule of thumb: connections = (core_count * 2) + spindle_count
# For 4-core server with ~1000 concurrent users:
HIKARI_MAX_POOL_SIZE=50
HIKARI_MIN_IDLE=10

# ── 4. CACHE (Redis) ───────────────────────────────────────────────────────

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password

# Lettuce connection pool — tuned for DAU 10K                     [optional]
REDIS_POOL_MAX_ACTIVE=40
REDIS_POOL_MAX_IDLE=20
REDIS_POOL_MIN_IDLE=10

# Cache TTL in ms (default: 1 hour)                               [optional]
CACHE_TTL_MS=3600000

# ── 5. SEARCH (Elasticsearch) ──────────────────────────────────────────────

ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ── 6. QUEUE (Kafka) ───────────────────────────────────────────────────────

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── 7. STORAGE (MinIO / S3-compatible) ──────────────────────────────────────

MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=replace-with-strong-minio-access-key
MINIO_SECRET_KEY=replace-with-strong-minio-secret-key
MINIO_BUCKET=verifix-jobs
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 8. EMAIL (SMTP) ────────────────────────────────────────────────────────
# Used for admin invites. Leave empty to disable email sending.

SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=noreply@job.verifix.uz
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ── 9. SMS GATEWAYS ────────────────────────────────────────────────────────

# Eskiz — primary SMS provider                                    [required if SMS enabled]
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=replace-with-eskiz-email
ESKIZ_PASSWORD=replace-with-eskiz-password

# PlayMobile — fallback SMS provider                              [optional]
PLAYMOBILE_BASE_URL=https://send.playmobile.uz
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=

# ── 10. TELEGRAM ────────────────────────────────────────────────────────────

# Bot credentials                                                  [required]
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=VerifixJobBot
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEB_APP_URL=https://job.verifix.uz

# Channel auto-posting (vacancies → public channel)               [optional]
TELEGRAM_CHANNEL_ENABLED=false
TELEGRAM_CHANNEL_CHAT_ID=
TELEGRAM_CHANNEL_POST_INTERVAL=3600000

# ── 11. PAYMENTS ────────────────────────────────────────────────────────────

# Click.uz                                                        [optional]
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_BASE_URL=https://my.click.uz

# Payme                                                           [optional]
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_BASE_URL=https://checkout.paycom.uz

# ── 12. KYC (MyID) ─────────────────────────────────────────────────────────

MYID_CLIENT_ID=
MYID_CLIENT_SECRET=
MYID_BASE_URL=https://myid.uz
MYID_REDIRECT_URI=${APP_BASE_URL}/api/v1/auth/myid/callback

# ── 13. VERIFIX HRM INTEGRATION ────────────────────────────────────────────

VERIFIX_HRM_URL=https://hrm.verifix.uz/api
VERIFIX_HRM_API_KEY=
HRM_VACANCY_SYNC_CRON=0 */30 * * * *

# HRM SSO (Biruni OAuth2)                                        [optional]
HRM_SSO_CLIENT_ID=
HRM_SSO_CLIENT_SECRET=
HRM_SSO_REDIRECT_URI=${APP_BASE_URL}/api/v1/hrm/sso/callback

# ── 14. GOVERNMENT INTEGRATIONS ────────────────────────────────────────────

ARGOS_API_URL=https://api.argos.uz
ARGOS_API_KEY=
ENST_API_URL=https://api.enst.uz
ENST_API_KEY=
MEHNAT_API_URL=https://api.ish.mehnat.uz
MEHNAT_API_KEY=

# ── 15. AI (Claude API) ────────────────────────────────────────────────────

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024

# ── 16. ML SERVICE ──────────────────────────────────────────────────────────

ML_SERVICE_URL=http://ml-service:8000
ML_GRPC_HOST=ml-service
ML_GRPC_PORT=50051

# ── 17. ATS TELEGRAM ───────────────────────────────────────────────────────

ATS_TELEGRAM_WEBHOOK_URL=
ATS_TELEGRAM_HMAC_SECRET=
ATS_TELEGRAM_COMPANY_CODE=default

# ── 18. OBSERVABILITY ──────────────────────────────────────────────────────

# Grafana admin credentials                                       [required]
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
GRAFANA_ROOT_URL=http://localhost:3000

# ── 19. FEATURE FLAGS (Module Toggles) ─────────────────────────────────────
# Set to true/false to enable/disable modules.
# Disabled modules skip bean registration, routes, schedulers,
# and do NOT require their secrets to be configured.

# Infrastructure modules
KAFKA_ENABLED=true
ELASTICSEARCH_ENABLED=true
MINIO_ENABLED=false

# Integration modules
ML_SERVICE_ENABLED=false
GOV_SYNC_ENABLED=false
HRM_SYNC_ENABLED=false
HRM_SSO_ENABLED=false
ATS_TELEGRAM_ENABLED=false

# AI modules
AI_CHATBOT_ENABLED=false
AI_SCREENING_ENABLED=false

# ── 20. RATE LIMITING & MODERATION ─────────────────────────────────────────

# API rate limits — tuned for DAU 10K
RATE_LIMIT_GENERAL_REQUESTS_PER_MINUTE=200
RATE_LIMIT_EMPLOYER_REQUESTS_PER_MINUTE=60

# Content moderation
MODERATION_MINIMUM_WAGE_UZS=1155000
MODERATION_BANNED_WORDS=MLM,network marketing,depozit,vlozhenie,piramida,zalog

# ── 21. PERFORMANCE TUNING (DAU 10K) ──────────────────────────────────────
# Override defaults from application-prod.yml if needed.

# Tomcat thread pool
TOMCAT_MAX_THREADS=400
TOMCAT_MIN_SPARE=40
TOMCAT_ACCEPT_COUNT=200
TOMCAT_MAX_CONNECTIONS=2000

# Async task executor
ASYNC_CORE_POOL=15
ASYNC_MAX_POOL=100
ASYNC_QUEUE_CAPACITY=500

# Scheduler
SCHEDULER_POOL_SIZE=10

# Vacancy defaults
VACANCY_EXPIRATION_DAYS=30
