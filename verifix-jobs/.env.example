# ============================================================
# VERIFIX JOBS — Environment Configuration
# ============================================================
# Скопируйте в .env и настройте значения.
# Все модули с ENABLED=false можно включать по мере необходимости.
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. CORE — Обязательные настройки (без них не запустится)
# ────────────────────────────────────────────────────────────

# Профиль: dev | staging | prod
SPRING_PROFILES_ACTIVE=dev
APP_NAME=verifix-jobs
APP_BASE_URL=http://localhost:8080
APP_PORT=8080

# PostgreSQL (обязательно)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verifix_jobs
POSTGRES_USER=verifix
POSTGRES_PASSWORD=changeme

# Redis (обязательно для сессий и кэша)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (обязательно — сгенерируйте: openssl rand -base64 64)
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ────────────────────────────────────────────────────────────
# 2. FEATURE TOGGLES — Включение/выключение модулей
# ────────────────────────────────────────────────────────────
# Начните с false, включайте по мере необходимости.

# Инфраструктурные сервисы
KAFKA_ENABLED=false
ELASTICSEARCH_ENABLED=false
MINIO_ENABLED=false
ML_SERVICE_ENABLED=false

# Интеграции с внешними системами
GOV_SYNC_ENABLED=false
HRM_SYNC_ENABLED=false
HRM_SSO_ENABLED=false
ATS_TELEGRAM_ENABLED=false

# AI функции (требует CLAUDE_API_KEY)
AI_CHATBOT_ENABLED=false
AI_SCREENING_ENABLED=false

# ────────────────────────────────────────────────────────────
# 3. TELEGRAM BOT — Основной канал для кандидатов
# ────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=verifixjobs_bot
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Канал для автопостинга вакансий
TELEGRAM_CHANNEL_ENABLED=false
TELEGRAM_CHANNEL_CHAT_ID=

# ────────────────────────────────────────────────────────────
# 4. SMS ШЛЮЗЫ — Уведомления кандидатов
# ────────────────────────────────────────────────────────────

# Eskiz.uz (основной)
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# PlayMobile (резервный)
PLAYMOBILE_BASE_URL=https://send.playmobile.uz
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=

# ────────────────────────────────────────────────────────────
# 5. ПЛАТЕЖНЫЕ СИСТЕМЫ — Монетизация
# ────────────────────────────────────────────────────────────

# Click.uz
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# ────────────────────────────────────────────────────────────
# 6. KYC / ВЕРИФИКАЦИЯ
# ────────────────────────────────────────────────────────────

# MyID.uz (идентификация)
MYID_CLIENT_ID=
MYID_CLIENT_SECRET=
MYID_REDIRECT_URI=${APP_BASE_URL}/api/v1/auth/myid/callback

# ────────────────────────────────────────────────────────────
# 7. ХРАНИЛИЩЕ ФАЙЛОВ (MinIO / S3)
# ────────────────────────────────────────────────────────────
# Включите: MINIO_ENABLED=true

MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=verifix-jobs

# ────────────────────────────────────────────────────────────
# 8. ПОИСК (Elasticsearch)
# ────────────────────────────────────────────────────────────
# Включите: ELASTICSEARCH_ENABLED=true
# Без ES работает DB fallback (ILIKE search)

ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ────────────────────────────────────────────────────────────
# 9. ОЧЕРЕДИ СООБЩЕНИЙ (Kafka)
# ────────────────────────────────────────────────────────────
# Включите: KAFKA_ENABLED=true

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ────────────────────────────────────────────────────────────
# 10. AI / CLAUDE API
# ────────────────────────────────────────────────────────────
# Включите: AI_CHATBOT_ENABLED=true и/или AI_SCREENING_ENABLED=true

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024

# ────────────────────────────────────────────────────────────
# 11. ML СЕРВИС (Python FastAPI + gRPC)
# ────────────────────────────────────────────────────────────
# Включите: ML_SERVICE_ENABLED=true

ML_SERVICE_URL=http://localhost:8000
ML_GRPC_HOST=localhost
ML_GRPC_PORT=50051

# ────────────────────────────────────────────────────────────
# 12. VERIFIX HRM ИНТЕГРАЦИЯ
# ────────────────────────────────────────────────────────────
# Включите: HRM_SYNC_ENABLED=true

VERIFIX_HRM_URL=https://hrm.verifix.uz/api
VERIFIX_HRM_API_KEY=
HRM_VACANCY_SYNC_CRON=0 */30 * * * *

# HRM SSO (Biruni OAuth2)
# Включите: HRM_SSO_ENABLED=true
HRM_SSO_CLIENT_ID=
HRM_SSO_CLIENT_SECRET=
HRM_SSO_REDIRECT_URI=${APP_BASE_URL}/api/v1/hrm/sso/callback

# ────────────────────────────────────────────────────────────
# 13. ATS TELEGRAM BOT ИНТЕГРАЦИЯ
# ────────────────────────────────────────────────────────────
# Включите: ATS_TELEGRAM_ENABLED=true

ATS_TELEGRAM_WEBHOOK_URL=http://localhost:3030
ATS_TELEGRAM_HMAC_SECRET=
ATS_TELEGRAM_COMPANY_CODE=default

# ────────────────────────────────────────────────────────────
# 14. ГОСУДАРСТВЕННЫЕ ИНТЕГРАЦИИ
# ────────────────────────────────────────────────────────────
# Включите: GOV_SYNC_ENABLED=true

ARGOS_API_URL=https://api.argos.uz
ARGOS_API_KEY=
ENST_API_URL=https://api.enst.uz
ENST_API_KEY=
MEHNAT_API_URL=https://api.ish.mehnat.uz
MEHNAT_API_KEY=

# ────────────────────────────────────────────────────────────
# 15. МОДЕРАЦИЯ И БЕЗОПАСНОСТЬ
# ────────────────────────────────────────────────────────────

MODERATION_MINIMUM_WAGE_UZS=1155000
RATE_LIMIT_GENERAL_REQUESTS_PER_MINUTE=100
RATE_LIMIT_EMPLOYER_REQUESTS_PER_MINUTE=30

# ────────────────────────────────────────────────────────────
# 16. МОНИТОРИНГ (для production)
# ────────────────────────────────────────────────────────────

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
ELASTIC_PASSWORD=changeme

# ────────────────────────────────────────────────────────────
# 17. CORS (для production — укажите реальный домен)
# ────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:4200,http://localhost:4201
