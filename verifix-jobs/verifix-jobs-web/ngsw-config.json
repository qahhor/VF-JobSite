{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/actuator/**",
    "!/ngsw-worker.js"
  ],
  "dataGroups": [
    {
      "name": "api-vacancies",
      "urls": ["/api/v1/public/vacancies*", "/api/v1/public/stats", "/api/v1/public/categories", "/api/v1/public/cities"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "5m",
        "timeout": "3s"
      }
    },
    {
      "name": "api-companies",
      "urls": ["/api/v1/public/companies*"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 30,
        "maxAge": "10m",
        "timeout": "3s"
      }
    },
    {
      "name": "api-salary",
      "urls": ["/api/v1/salary/*", "/api/v1/intelligence/salary/*"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 20,
        "maxAge": "1h"
      }
    }
  ]
}
