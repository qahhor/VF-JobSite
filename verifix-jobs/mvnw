#!/usr/bin/env sh
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
PROPERTIES_FILE="$WRAPPER_DIR/maven-wrapper.properties"
DIST_URL=$(grep '^distributionUrl=' "$PROPERTIES_FILE" | cut -d'=' -f2-)
INSTALL_DIR="$WRAPPER_DIR/apache-maven"
ARCHIVE_FILE="$WRAPPER_DIR/apache-maven.zip"

if [ ! -x "$INSTALL_DIR/bin/mvn" ]; then
  mkdir -p "$WRAPPER_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$DIST_URL" -o "$ARCHIVE_FILE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$DIST_URL" -O "$ARCHIVE_FILE"
  else
    echo "curl or wget is required to download Maven." >&2
    exit 1
  fi

  rm -rf "$INSTALL_DIR"
  unzip -q "$ARCHIVE_FILE" -d "$WRAPPER_DIR"
  EXTRACTED_DIR=$(find "$WRAPPER_DIR" -maxdepth 1 -type d -name 'apache-maven-*' | head -n 1)
  mv "$EXTRACTED_DIR" "$INSTALL_DIR"
fi

exec "$INSTALL_DIR/bin/mvn" "$@"
