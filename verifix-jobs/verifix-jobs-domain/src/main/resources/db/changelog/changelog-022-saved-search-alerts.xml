<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="022-01" author="codex">
        <addColumn tableName="saved_search">
            <column name="name" type="VARCHAR(200)"/>
            <column name="last_notified_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <createIndex tableName="saved_search" indexName="idx_saved_search_candidate_notify">
            <column name="candidate_id"/>
            <column name="notify_enabled"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
