<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- HRM Sync Log: tracks all sync operations between Jobs and HRM -->
    <changeSet id="014-01" author="verifix">
        <createTable tableName="hrm_sync_log">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="sync_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="direction" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(50)"/>
            <column name="jobs_entity_id" type="uuid"/>
            <column name="hrm_entity_id" type="VARCHAR(100)"/>
            <column name="sync_status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="payload" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
            <column name="synced_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="hrm_sync_log" indexName="idx_hrm_sync_log_status">
            <column name="sync_status"/>
            <column name="sync_type"/>
        </createIndex>
        <createIndex tableName="hrm_sync_log" indexName="idx_hrm_sync_log_entity">
            <column name="entity_type"/>
            <column name="jobs_entity_id"/>
        </createIndex>
    </changeSet>

    <!-- HRM Vacancy Mapping: maps HRM vacancies to Jobs vacancies -->
    <changeSet id="014-02" author="verifix">
        <createTable tableName="hrm_vacancy_mapping">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="hrm_company_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="hrm_vacancy_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="jobs_vacancy_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_id" type="BIGINT"/>
            <column name="sync_direction" type="VARCHAR(20)" defaultValue="HRM_TO_JOBS"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
        </createTable>
        <addUniqueConstraint tableName="hrm_vacancy_mapping"
                             columnNames="hrm_company_id, hrm_vacancy_id"
                             constraintName="uq_hrm_vacancy_mapping"/>
    </changeSet>

    <!-- HRM Candidate Mapping: maps Jobs candidates to HRM candidates -->
    <changeSet id="014-03" author="verifix">
        <createTable tableName="hrm_candidate_mapping">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="jobs_candidate_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="hrm_company_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="hrm_candidate_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="synced_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
        </createTable>
        <addUniqueConstraint tableName="hrm_candidate_mapping"
                             columnNames="jobs_candidate_id, hrm_company_id"
                             constraintName="uq_hrm_candidate_mapping"/>
    </changeSet>

    <!-- HRM SSO Mapping: maps Biruni users to Jobs employers/managers -->
    <changeSet id="014-04" author="verifix">
        <createTable tableName="hrm_sso_mapping">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="hrm_company_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="hrm_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="jobs_employer_id" type="uuid"/>
            <column name="jobs_manager_id" type="uuid"/>
            <column name="hrm_username" type="VARCHAR(200)"/>
            <column name="hrm_full_name" type="VARCHAR(300)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
            <column name="last_login_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addUniqueConstraint tableName="hrm_sso_mapping"
                             columnNames="hrm_company_id, hrm_user_id"
                             constraintName="uq_hrm_sso_mapping"/>
    </changeSet>

    <!-- Add hrm_company_id to employer for linking -->
    <changeSet id="014-05" author="verifix">
        <addColumn tableName="employer">
            <column name="hrm_company_id" type="VARCHAR(100)"/>
        </addColumn>
        <addColumn tableName="employer">
            <column name="hrm_sync_enabled" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
