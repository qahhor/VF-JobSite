<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-01-referral" author="verifix">
        <createTable tableName="referral">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="referrer_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_referral_referrer" references="candidate(id)"/>
            </column>
            <column name="referee_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_referral_referee" references="candidate(id)"/>
            </column>
            <column name="vacancy_id" type="uuid">
                <constraints foreignKeyName="fk_referral_vacancy" references="vacancy(id)"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="INVITED">
                <constraints nullable="false"/>
            </column>
            <column name="reward_status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="reward_amount" type="numeric(15,2)"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <changeSet id="003-02-notification" author="verifix">
        <createTable tableName="notification">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="channel" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="jsonb"/>
            <column name="sent_at" type="timestamp with time zone"/>
            <column name="delivered_at" type="timestamp with time zone"/>
            <column name="read_at" type="timestamp with time zone"/>
            <column name="retry_count" type="integer" defaultValueNumeric="0"/>
            <column name="error_message" type="text"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <changeSet id="003-03-sms-log" author="verifix">
        <createTable tableName="sms_log">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="phone" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="message_text" type="text"/>
            <column name="provider" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="cost" type="numeric(10,4)"/>
            <column name="external_id" type="varchar(255)"/>
            <column name="sent_at" type="timestamp with time zone"/>
            <column name="delivered_at" type="timestamp with time zone"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <changeSet id="003-04-verification-log" author="verifix">
        <createTable tableName="verification_log">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="method" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="response_json" type="jsonb"/>
            <column name="verified_at" type="timestamp with time zone"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <changeSet id="003-05-moderation-queue" author="verifix">
        <createTable tableName="moderation_queue">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="moderator_id" type="uuid"/>
            <column name="reason" type="text"/>
            <column name="decided_at" type="timestamp with time zone"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <changeSet id="003-06-work-history" author="verifix">
        <createTable tableName="work_history">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="candidate_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_work_history_candidate" references="candidate(id)"/>
            </column>
            <column name="job_title" type="varchar(255)"/>
            <column name="company_name" type="varchar(255)"/>
            <column name="employment_type" type="varchar(20)"/>
            <column name="start_date" type="date"/>
            <column name="end_date" type="date"/>
            <column name="description" type="text"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <changeSet id="003-07-consent-log" author="verifix">
        <createTable tableName="consent_log">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="consent_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="varchar(20)"/>
            <column name="given_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="withdrawn_at" type="timestamp with time zone"/>
            <column name="ip_address" type="varchar(50)"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
