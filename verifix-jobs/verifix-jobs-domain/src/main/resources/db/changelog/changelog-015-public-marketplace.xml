<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Add slug to vacancy for SEO-friendly URLs -->
    <changeSet id="015-01" author="verifix">
        <addColumn tableName="vacancy">
            <column name="slug" type="VARCHAR(300)"/>
            <column name="view_count" type="INTEGER" defaultValueNumeric="0"/>
            <column name="apply_count" type="INTEGER" defaultValueNumeric="0"/>
        </addColumn>
        <createIndex tableName="vacancy" indexName="idx_vacancy_slug" unique="true">
            <column name="slug"/>
        </createIndex>
    </changeSet>

    <!-- Add slug to employer for SEO-friendly company pages -->
    <changeSet id="015-02" author="verifix">
        <addColumn tableName="employer">
            <column name="slug" type="VARCHAR(300)"/>
            <column name="description" type="TEXT"/>
            <column name="employee_count_range" type="VARCHAR(30)"/>
            <column name="founded_year" type="INTEGER"/>
            <column name="website_url" type="VARCHAR(500)"/>
        </addColumn>
        <createIndex tableName="employer" indexName="idx_employer_slug" unique="true">
            <column name="slug"/>
        </createIndex>
    </changeSet>

    <!-- Employer Task (auto-generated action items) -->
    <changeSet id="015-03" author="verifix">
        <createTable tableName="employer_task">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="employer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="manager_id" type="uuid"/>
            <column name="task_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="priority" type="VARCHAR(10)" defaultValue="MEDIUM"/>
            <column name="status" type="VARCHAR(20)" defaultValue="OPEN"/>
            <column name="entity_type" type="VARCHAR(50)"/>
            <column name="entity_id" type="uuid"/>
            <column name="due_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
        </createTable>
        <createIndex tableName="employer_task" indexName="idx_employer_task_employer_status">
            <column name="employer_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- Activity Event (real-time feed) -->
    <changeSet id="015-04" author="verifix">
        <createTable tableName="activity_event">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="employer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)"/>
            <column name="description" type="TEXT"/>
            <column name="actor_type" type="VARCHAR(20)"/>
            <column name="actor_id" type="uuid"/>
            <column name="actor_name" type="VARCHAR(200)"/>
            <column name="entity_type" type="VARCHAR(50)"/>
            <column name="entity_id" type="uuid"/>
            <column name="metadata" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
        </createTable>
        <createIndex tableName="activity_event" indexName="idx_activity_event_employer_created">
            <column name="employer_id"/>
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- AI Agent Run tracking -->
    <changeSet id="015-05" author="verifix">
        <createTable tableName="ai_agent_run">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="employer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="agent_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="RUNNING"/>
            <column name="input_data" type="JSONB"/>
            <column name="output_data" type="JSONB"/>
            <column name="tokens_used" type="INTEGER" defaultValueNumeric="0"/>
            <column name="duration_ms" type="BIGINT"/>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <!-- AI Screening Result -->
    <changeSet id="015-06" author="verifix">
        <createTable tableName="ai_screening_result">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="application_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="agent_run_id" type="uuid"/>
            <column name="score" type="INTEGER"/>
            <column name="recommendation" type="VARCHAR(20)"/>
            <column name="summary" type="TEXT"/>
            <column name="pros" type="JSONB"/>
            <column name="cons" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
        </createTable>
        <addUniqueConstraint tableName="ai_screening_result" columnNames="application_id" constraintName="uq_ai_screening_application"/>
    </changeSet>

    <!-- Vacancy Template -->
    <changeSet id="015-07" author="verifix">
        <createTable tableName="vacancy_template">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="employer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="template_data" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="use_count" type="INTEGER" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <!-- Saved Search (candidate favorites) -->
    <changeSet id="015-08" author="verifix">
        <createTable tableName="saved_search">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="candidate_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="search_type" type="VARCHAR(20)" defaultValue="VACANCY"/>
            <column name="query" type="VARCHAR(500)"/>
            <column name="filters" type="JSONB"/>
            <column name="notify_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- Favorite Vacancy -->
    <changeSet id="015-09" author="verifix">
        <createTable tableName="favorite_vacancy">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="candidate_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="vacancy_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
        </createTable>
        <addUniqueConstraint tableName="favorite_vacancy" columnNames="candidate_id, vacancy_id" constraintName="uq_favorite_vacancy"/>
    </changeSet>

</databaseChangeLog>
