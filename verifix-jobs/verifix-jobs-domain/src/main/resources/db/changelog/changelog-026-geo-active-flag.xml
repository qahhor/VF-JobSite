<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Add is_active flag to geo_city and geo_region for admin-controlled visibility -->
    <changeSet id="026-01" author="claude">
        <addColumn tableName="geo_city">
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="geo_region">
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="geo_city" indexName="idx_geo_city_is_active">
            <column name="is_active"/>
        </createIndex>
        <createIndex tableName="geo_region" indexName="idx_geo_region_is_active">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
