<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Employer lifecycle: verified_at, deactivated_at, deactivation_reason + BLOCKED status support -->
    <changeSet id="027-01" author="claude">
        <addColumn tableName="employer">
            <column name="verified_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="deactivated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="deactivation_reason" type="TEXT"/>
        </addColumn>

        <!-- Indexes for admin filtering by status/verified -->
        <createIndex tableName="employer" indexName="idx_employer_is_verified">
            <column name="is_verified"/>
        </createIndex>
        <createIndex tableName="employer" indexName="idx_employer_status_verified">
            <column name="status"/>
            <column name="is_verified"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
